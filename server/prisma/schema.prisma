// Aamstrand ERP database schema.
//
// Design notes for the migration off localStorage:
// - Money fields use Decimal, not float, to avoid rounding drift.
// - Addresses (Customer.billTo, ShippingLocation.address, SalesOrder.billTo/
//   shipTo, Vendor.address) are stored as JSON rather than normalized into
//   their own table. They're always read/written as a whole object and
//   never queried by sub-field (no "customers in state=IL" today), so JSONB
//   is the pragmatic choice; revisit if that changes.
// - SalesOrder is what the frontend's TypeScript still (confusingly) calls
//   `PurchaseOrder` - it's the order we create FROM a customer's PO, not an
//   outbound purchase order. Renamed at the DB/API boundary since this is a
//   natural point to fix that; VendorPurchaseOrder is the real outbound PO.
// - A few semi-structured, order-workflow-internal fields stay JSON
//   (allocation, pendingShipment, bol, Account.permissions) rather than
//   being fully normalized in this first pass - they're read/written as a
//   unit by business logic, not queried piecemeal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOM
}

enum OrderStatus {
  ENTERED
  CHECKED
  ALLOCATED
  BACKORDERED
  PICK_PACKED
  SHIPPED
  // Closed without (fully) shipping - releases any stock the order held.
  CANCELLED
}

enum PickPackStatus {
  PARTIAL
  COMPLETE
}

enum VendorPoStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

enum ReturnStatus {
  ISSUED
  RECEIVED
  CLOSED
}

model Account {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role
  // Record<pageKey, "view" | "edit"> - only meaningful when role = CUSTOM.
  // Admin bypasses this entirely and always has full access.
  permissions  Json?
  initials     String
  // Hex color for this account's stamps/initials on orders (checked stamp,
  // "Entered by" signature) - chosen per-account so everyone's marks are
  // visually distinct at a glance.
  color        String   @default("#4c6ef5")
  // A deactivated account can no longer log in or use an existing token -
  // an administrative suspend that's reversible, unlike deleting the row.
  active       Boolean  @default(true)
  // Bumped to invalidate every outstanding JWT for this account at once
  // (see requireAuth) - the mechanism behind "Force Logout", since tokens
  // are otherwise stateless and can't be revoked individually.
  tokenVersion Int      @default(0)
  // Set on a freshly seeded admin and whenever an admin resets someone's
  // password: the account can sign in but every other request is refused
  // until the person picks their own password (POST /api/auth/change-password).
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
}

// Administrative accountability trail - who did what, when. Scoped to the
// Postgres-backed parts of the app (accounts, auth) since orders/items/etc.
// still live in each browser's localStorage and have no server side to log
// from; see the localStorage stores' own migration note.
model AuditLog {
  id            String   @id @default(uuid())
  // Snapshotted rather than a relation, so the log still reads correctly
  // after the actor or target account is deleted.
  actorId       String?
  actorUsername String
  action        String
  targetType    String
  targetId      String?
  targetLabel   String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  accountNumber    String   @default("")
  billTo           Json
  terms            String   @default("")
  shipVia          String   @default("")
  fob              String   @default("")
  rep              String   @default("")
  shipCompleteOnly Boolean  @default(false)
  privateLabelName String?
  routingGuide     Json?
  // Tax handling for invoices: an exempt customer (a reseller with a
  // certificate on file) is invoiced with no tax whatever the order's rate.
  taxExempt        Boolean  @default(false)
  // A customer with history is never deleted (its orders, returns, invoices
  // and credit memos reference it); it is made inactive instead, which
  // hides it from Order Entry and the returns form (R4-06).
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  // Optimistic concurrency - see Item.version.
  version          Int      @default(1)

  shipToLocations ShippingLocation[]
  invoices        Invoice[]
  creditMemos     CreditMemo[]
  notes           CustomerNote[]
  partNumberMap   CustomerPartMapping[]
  priceOverrides  CustomerPriceOverride[]
  salesOrders     SalesOrder[]
  returns         ReturnAuthorization[]

  @@index([name])
}

model ShippingLocation {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("")
  address    Json

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerPartMapping {
  id                 String   @id @default(uuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemNumber         String
  customerPartNumber String

  @@index([customerId])
  @@index([itemNumber])
}

model CustomerPriceOverride {
  id                 String   @id @default(uuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemNumber         String
  customerPartNumber String   @default("")
  description        String   @default("")
  price              Decimal  @db.Decimal(12, 4)
  pricePerFt         Decimal? @db.Decimal(12, 4)
  length             Decimal? @db.Decimal(12, 4)
  weight             Decimal? @db.Decimal(12, 4)

  @@index([customerId])
  @@index([itemNumber])
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  // Optimistic concurrency - see Item.version.
  version     Int      @default(1)

  itemsPreferring      Item[]
  vendorPurchaseOrders VendorPurchaseOrder[]

  @@index([name])
}

model Item {
  id                 String   @id @default(uuid())
  // Also unique case- and whitespace-insensitively: every lookup in the app
  // matches that way, so "BR-1001" and "br-1001 " must be the same item. The
  // functional index lower(btrim("itemNumber")) lives in the
  // 20260928120000_phase1_hardening migration; Prisma can't express it here.
  itemNumber         String   @unique
  description        String
  um                 String   @default("EA")
  rate               Decimal  @default(0) @db.Decimal(12, 4)
  qtyOnHand          Int      @default(0)
  qtyOnPurchaseOrder Int      @default(0)
  // Units held by open orders (allocated or staged, not yet shipped): the
  // sum of this item's Allocation rows, maintained in the same transaction
  // as every order step. Available = qtyOnHand - qtyReserved (sprint 2).
  qtyReserved        Int      @default(0)
  reorderPoint       Int?
  countryOfOrigin    String?
  // Weight per unit (lbs) - drives order/shipment weight for warehouse
  // capacity tracking.
  weight             Decimal? @db.Decimal(12, 4)
  notes              String?
  preferredVendorId  String?
  preferredVendor    Vendor?  @relation(fields: [preferredVendorId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  // Optimistic concurrency: bumped on every whole-object PUT. A save whose
  // client-supplied version doesn't match the current row means someone
  // else changed it first - rejected with 409 rather than silently
  // overwritten. Not touched by the atomic qty PATCH endpoint, which is
  // deliberately outside this whole-object path.
  version            Int      @default(1)

  components ItemComponent[]
  links      ItemLink[]

  salesOrderLines SalesOrderLine[] @relation("SalesOrderLineItem")
  vendorPoLines   VendorPoLine[]   @relation("VendorPoLineItem")
  returnLines     ReturnLine[]     @relation("ReturnLineItem")
  stockMovements  StockMovement[]
  invoiceLines    InvoiceLine[]
  creditMemoLines CreditMemoLine[]
  allocations     Allocation[]

  @@index([preferredVendorId])
}

model ItemComponent {
  id          String  @id @default(uuid())
  itemId      String
  item        Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  partNumber  String
  description String?

  @@index([itemId])
}

model ItemLink {
  id     String @id @default(uuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label  String
  url    String

  @@index([itemId])
}

model SalesOrder {
  // Matches the existing app's human-facing S.O. numbers (10001, 10002, ...)
  // - assigned atomically via the shared Counter table at creation time
  // (key "salesOrder"), same pattern as VendorPurchaseOrder's poNumber and
  // ReturnAuthorization's raNumber, not a Postgres-native autoincrement -
  // keeps every human-facing document number going through the one
  // concurrency-safe mechanism.
  soNumber             Int             @id
  poNumber             String          @default("")
  orderDate            DateTime        @db.Date
  dueDate              DateTime        @db.Date
  customerId           String?
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipToLocationId     String?
  billTo               Json
  shipTo               Json
  fob                  String          @default("")
  shipVia              String          @default("")
  terms                String          @default("")
  rep                  String          @default("")
  taxRate              Decimal         @default(0) @db.Decimal(6, 3)
  notes                String          @default("")
  status               OrderStatus     @default(ENTERED)
  writtenBy            String?
  writtenById          String?
  writtenByColor       String?
  checkedAt            DateTime?
  checkedBy            String?
  checkedByColor       String?
  allocation           Json?
  labelPrintedAt       DateTime?
  pickedAt             DateTime?
  pendingShipment      Json?
  pickListPrintedAt    DateTime?
  packingSlipPrintedAt DateTime?
  estimatedShipDate    DateTime?       @db.Date
  pickPackStatus       PickPackStatus?
  bol                  Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
  // Optimistic concurrency - see Item.version.
  version              Int             @default(1)

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  lineItems       SalesOrderLine[]
  shipmentHistory ShipmentRecord[]
  invoices        Invoice[]
  allocations     Allocation[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderDate])
  @@index([dueDate])
}

model SalesOrderLine {
  id                 String     @id @default(uuid())
  soNumber           Int
  salesOrder         SalesOrder @relation(fields: [soNumber], references: [soNumber], onDelete: Cascade)
  // Catalog link resolved server-side on save. `item` keeps the item # as
  // entered/printed, and follows a rename of the catalog item.
  itemId             String?
  catalogItem        Item?      @relation("SalesOrderLineItem", fields: [itemId], references: [id], onDelete: SetNull)
  item               String
  description        String
  um                 String     @default("EA")
  ordered            Int
  rate               Decimal    @db.Decimal(12, 4)
  customerPartNumber String?
  // The stock this line is holding, if any (see Allocation).
  allocation         Allocation?

  @@index([soNumber])
  @@index([item])
  @@index([itemId])
}

// One row per order line that is holding stock: allocated but not yet
// released, or released (staged) but not yet shipped. Kept in step with the
// order's allocation / pendingShipment JSON in the same transaction as every
// order step, and summed into Item.qtyReserved, so "available" is one
// column read instead of a walk over every open order (sprint 2, A-25).
model Allocation {
  id         String         @id @default(uuid())
  soNumber   Int
  salesOrder SalesOrder     @relation(fields: [soNumber], references: [soNumber], onDelete: Cascade)
  lineItemId String         @unique
  line       SalesOrderLine @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty        Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  @@index([soNumber])
  @@index([itemId])
}

model ShipmentRecord {
  id         String     @id @default(uuid())
  soNumber   Int
  salesOrder SalesOrder @relation(fields: [soNumber], references: [soNumber], onDelete: Cascade)
  shippedAt  DateTime   @default(now())
  // [{ lineItemId, qty }]
  lines      Json
  // The invoice raised for this shipment (one per shipment); voided, not
  // deleted, when the shipment is undone.
  invoice    Invoice?

  @@index([soNumber])
  @@index([shippedAt])
}

model VendorPurchaseOrder {
  // App-generated, formatted "PO-5001" etc. - see the po_number_seq sequence.
  poNumber     String         @id
  vendorId     String
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  vendorName   String
  orderDate    DateTime       @db.Date
  expectedDate DateTime?      @db.Date
  status       VendorPoStatus @default(OPEN)
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  // Optimistic concurrency - see Item.version.
  version      Int            @default(1)

  lines            VendorPoLine[]
  receivingHistory VendorReceivingRecord[]

  @@index([vendorId])
  @@index([status])
}

model VendorPoLine {
  id          String              @id @default(uuid())
  poNumber    String
  vendorPo    VendorPurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  itemId      String?
  catalogItem Item?               @relation("VendorPoLineItem", fields: [itemId], references: [id], onDelete: SetNull)
  itemNumber  String
  description String
  orderedQty  Int
  receivedQty Int                 @default(0)
  cost        Decimal             @db.Decimal(12, 4)

  @@index([poNumber])
  @@index([itemNumber])
  @@index([itemId])
}

model VendorReceivingRecord {
  id         String              @id @default(uuid())
  poNumber   String
  vendorPo   VendorPurchaseOrder @relation(fields: [poNumber], references: [poNumber], onDelete: Cascade)
  receivedAt DateTime            @default(now())
  // [{ lineId, qty }]
  lines      Json

  @@index([poNumber])
}

model ReturnAuthorization {
  // App-generated, formatted "RA-3001" etc, same pattern as VendorPurchaseOrder.
  raNumber       String       @id
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Free-text reference to the original sales order, not a real FK - a
  // customer can return goods without one on hand.
  soNumber       String?
  billTo         Json
  requestDate    DateTime     @db.Date
  reason         String       @default("")
  status         ReturnStatus @default(ISSUED)
  notes          String       @default("")
  writtenBy      String?
  writtenById    String?
  writtenByColor String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  // Set when the returned goods are received back at the dock (restocking
  // any lines marked restock) - see POST /returns/:ra/receive.
  receivedAt     DateTime?
  receivedBy     String?
  // Optimistic concurrency - see Item.version.
  version        Int          @default(1)

  lines      ReturnLine[]
  creditMemo CreditMemo?

  @@index([customerId])
  @@index([status])
}

model ReturnLine {
  id          String              @id @default(uuid())
  raNumber    String
  returnAuth  ReturnAuthorization @relation(fields: [raNumber], references: [raNumber], onDelete: Cascade)
  itemId      String?
  catalogItem Item?               @relation("ReturnLineItem", fields: [itemId], references: [id], onDelete: SetNull)
  itemNumber  String
  description String
  um          String              @default("EA")
  qty         Int
  rate        Decimal             @db.Decimal(12, 4)
  reason      String              @default("")
  // Whether received units go back on the shelf (false = damaged/scrap).
  restock     Boolean             @default(true)

  @@index([raNumber])
  @@index([itemNumber])
  @@index([itemId])
}

// Every change to an item's qtyOnHand, written in the same transaction as
// the change itself - the stock ledger behind "who moved this, and why".
model StockMovement {
  id            String   @id @default(uuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemNumber    String
  delta         Int
  qtyAfter      Int
  // SHIP | UNDO_SHIP | RECEIVE_PO | RETURN | ADJUST
  reason        String
  // e.g. "sales-order" / "10042", "vendor-po" / "PO-5003", "return" / "RA-3001"
  refType       String?
  refId         String?
  actorId       String?
  actorUsername String
  createdAt     DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([refType, refId])
}

// Small key/value bag for app-wide settings (company profile, default lead
// time, warehouse capacity lookback) - value is always a JSON-encoded
// string, decoded/encoded at the API boundary so this table stays generic.
model Setting {
  key   String @id
  value String
}

// Human-facing document numbers (vendor PO "PO-5001", eventually S.O. #,
// return RA #) that used to be a per-browser localStorage counter - now a
// real row every browser reads/increments atomically, so two people
// creating a document at the same moment can't land on the same number.
model Counter {
  key   String @id
  value Int    @default(0)
}

// A "memorized" report (QuickBooks' term): the report's configuration only
// (data source + filters + columns), never its result rows, so re-opening
// it always re-runs live against current data.
model SavedReport {
  id            String   @id @default(uuid())
  name          String
  dataSourceKey String
  filters       Json
  columns       Json
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Invoicing and the accounting bridge (round 5, section 05 of the review).
//
// This system is the record for customers, items, prices, orders, stock and
// shipments, and it raises the invoice and credit memo documents. The
// accounting package (QuickBooks) is the record for money: receivables,
// payments, tax filing and the ledger. Invoices and credit memos are pushed
// to it through the outbox below; nothing financial is computed here beyond
// the document totals.

// A document is a Draft from the moment its shipment or return creates it
// until Accounting reviews and issues it (sprint 2): only then does it get
// its number and go to QuickBooks.
enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

// An ITEM line comes from the shipment or the return; a CHARGE line is
// added at review: freight, handling, a restocking deduction.
enum DocLineKind {
  ITEM
  CHARGE
}

// One invoice per shipment, raised inside the ship transaction from the
// order's lines and prices as they stood at that moment. Money is stored to
// the cent; the totals are computed in integer cents (lib/money.ts).
model Invoice {
  id               String          @id @default(uuid())
  // "INV-20001" - from the shared Counter table, assigned when the draft is
  // issued, so a draft that is undone never burns a number.
  invoiceNumber    String?         @unique
  soNumber         Int
  salesOrder       SalesOrder      @relation(fields: [soNumber], references: [soNumber])
  shipmentRecordId String?         @unique
  shipmentRecord   ShipmentRecord? @relation(fields: [shipmentRecordId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName     String
  billTo           Json
  shipTo           Json
  poNumber         String          @default("")
  terms            String          @default("")
  rep              String          @default("")
  invoiceDate      DateTime        @db.Date
  dueDate          DateTime        @db.Date
  subtotal         Decimal         @db.Decimal(14, 2)
  taxRate          Decimal         @default(0) @db.Decimal(6, 3)
  tax              Decimal         @db.Decimal(14, 2)
  total            Decimal         @db.Decimal(14, 2)
  status           InvoiceStatus   @default(DRAFT)
  approvedAt       DateTime?
  approvedBy       String?
  voidedAt         DateTime?
  voidedBy         String?
  voidReason       String?
  notes            String          @default("")
  // Optimistic concurrency for draft edits - see Item.version.
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  lines InvoiceLine[]

  @@index([soNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
}

model InvoiceLine {
  id               String      @id @default(uuid())
  invoiceId        String
  invoice          Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind             DocLineKind @default(ITEM)
  // Tax applies to the line (charges such as freight may be exempt).
  taxable          Boolean     @default(true)
  position         Int         @default(0)
  salesOrderLineId String?
  itemId           String?
  catalogItem      Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  item             String
  description      String
  um               String  @default("EA")
  qty              Int
  rate             Decimal @db.Decimal(12, 4)
  amount           Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([itemId])
}

// One credit memo per received return, priced from the invoice that billed
// the goods when one can be found, else from the RA line.
model CreditMemo {
  id               String              @id @default(uuid())
  // "CM-30001", assigned when the draft is issued.
  creditMemoNumber String?             @unique
  raNumber         String              @unique
  returnAuth       ReturnAuthorization @relation(fields: [raNumber], references: [raNumber])
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName     String
  billTo           Json
  // The sales order the return referenced, if any.
  soNumber         String?
  memoDate         DateTime            @db.Date
  subtotal         Decimal             @db.Decimal(14, 2)
  taxRate          Decimal             @default(0) @db.Decimal(6, 3)
  tax              Decimal             @db.Decimal(14, 2)
  total            Decimal             @db.Decimal(14, 2)
  status           InvoiceStatus       @default(DRAFT)
  approvedAt       DateTime?
  approvedBy       String?
  voidedAt         DateTime?
  voidedBy         String?
  voidReason       String?
  reason           String              @default("")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  lines CreditMemoLine[]

  @@index([customerId])
  @@index([memoDate])
}

model CreditMemoLine {
  id               String      @id @default(uuid())
  creditMemoId     String
  creditMemo       CreditMemo  @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  kind             DocLineKind @default(ITEM)
  taxable          Boolean     @default(true)
  position         Int         @default(0)
  returnLineId     String?
  // The invoice line whose price this credit reverses, when found.
  invoiceNumber    String?
  itemId           String?
  catalogItem      Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  item             String
  description      String
  um               String     @default("EA")
  qty              Int
  rate             Decimal    @db.Decimal(12, 4)
  amount           Decimal    @db.Decimal(14, 2)

  @@index([creditMemoId])
}

// The id an outside system (QuickBooks) knows one of our records by. Ids,
// never names, are the join key; names change.
// One row per Idempotency-Key a client sent on a create request: the first
// request claims the key, the response is stored, and a repeat (a double
// click, a retried request after a dropped connection) gets the same
// answer back instead of a second order, PO or return (R4-16).
model IdempotencyKey {
  scope     String
  key       String
  accountId String
  // 0 while the first request is still running; the HTTP status after.
  status    Int      @default(0)
  body      Json?
  createdAt DateTime @default(now())

  @@id([scope, key, accountId])
  @@index([createdAt])
}

model ExternalRef {
  id           String   @id @default(uuid())
  system       String
  // customer | item | invoice | credit-memo
  entityType   String
  entityId     String
  externalId   String
  // QuickBooks' optimistic-concurrency token for the record, needed to void.
  syncToken    String?
  lastSyncedAt DateTime @default(now())

  @@unique([system, entityType, entityId])
  @@index([system, entityType, externalId])
}

// Work waiting to be pushed to an outside system. Written in the same
// transaction as the document it describes, so an invoice can never exist
// here without a row saying it must reach QuickBooks - and the worker
// (integrations/sync.ts) retries with backoff until it does or gives up.
model SyncOutbox {
  id            String    @id @default(uuid())
  system        String
  entityType    String
  entityId      String
  // UPSERT | VOID
  action        String
  // PENDING | PROCESSING | DONE | FAILED (will retry) | DEAD (gave up)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  processedAt   DateTime?

  @@index([system, status, nextAttemptAt])
  @@index([entityType, entityId])
}

// Every attempt the worker made, success or failure - what the Activity
// Log's integration view shows.
model SyncLog {
  id         String   @id @default(uuid())
  system     String
  entityType String
  entityId   String
  action     String
  ok         Boolean
  message    String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// The OAuth connection to one QuickBooks company. Tokens are encrypted at
// rest with TOKEN_ENCRYPTION_KEY when it is set (see integrations/secrets.ts).
model IntegrationConnection {
  system           String   @id
  realmId          String
  environment      String   @default("sandbox")
  accessToken      String
  refreshToken     String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  connectedBy      String?
  connectedAt      DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  // Free-form per-connection configuration (income account, item type...).
  config           Json?
}
