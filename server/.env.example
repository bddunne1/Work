DATABASE_URL="postgresql://erp_app:CHANGE_ME@localhost:5432/erp_dev?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# How long a sign-in lasts (jsonwebtoken duration, e.g. 10h, 8h, 30m).
TOKEN_TTL=10h
# Behind nginx/Caddy: number of proxy hops to trust for the client address.
# TRUST_PROXY=1
# Browsers may call the API only from these origins (comma separated). Unset
# allows any origin, which is fine for local development only.
# CORS_ORIGIN=https://erp.example.com
# Scheduled report groups are emailed through this SMTP server
# (smtp://user:pass@host:587 or smtps://user:pass@host:465). Unset, the
# worker logs the message instead of sending it. MAIL_FROM is the sender.
# SMTP_URL=smtp://user:pass@mail.example.com:587
# MAIL_FROM=reports@example.com
# How often the worker checks for due schedules (ms; 0 disables).
# REPORT_SCHEDULE_INTERVAL_MS=60000
