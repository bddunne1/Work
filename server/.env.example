DATABASE_URL="postgresql://erp_app:CHANGE_ME@localhost:5432/erp_dev?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# How long a sign-in lasts (jsonwebtoken duration, e.g. 10h, 8h, 30m).
TOKEN_TTL=10h
# Behind nginx/Caddy: number of proxy hops to trust for the client address.
# TRUST_PROXY=1
# Browsers may call the API only from these origins (comma separated). Unset
# allows any origin, which is fine for local development only.
# CORS_ORIGIN=https://erp.example.com
